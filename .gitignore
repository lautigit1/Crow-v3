# ─── Raíz (husky/commitlint) ───────────────────────────────────────────────────
/node_modules/

# ─── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.cache/

# ─── Backend ──────────────────────────────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.venv/
backend/venv/
backend/.env
backend/*.db
backend/*.sqlite3
backend/.pytest_cache/
backend/**/.pytest_cache/

# ─── Docker ───────────────────────────────────────────────────────────────────
.env
.env.local
.env.production
# Respaldos: un .env.bak suelto es un archivo con todas las credenciales
# que no está cubierto por el patrón `.env` de arriba.
.env.bak
.env.*.bak
*.env.bak
docker-compose.override.yml

# ─── Base de datos / volúmenes ────────────────────────────────────────────────
postgres-data/
pgdata/
*.sql.bak
*.dump

# Salida de deploy/backup-postgres.sh -- nunca commitear un dump de la DB.
deploy/backups/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.pem
*.key
*.cert
.cache/
tmp/
