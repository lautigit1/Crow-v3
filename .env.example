# ─────────────────────────────────────────────────────────────
# Crow Repuestos — Variables de entorno
# Copiá este archivo a .env y completá los valores.
#   Desarrollo:  docker compose up --build
#   Producción:  docker compose -f docker-compose.prod.yml up -d --build
#                (ver DEPLOY.md)
# ─────────────────────────────────────────────────────────────

# REQUERIDO (dev y prod) — Clave secreta para firmar los JWT.
# Generá una con: openssl rand -hex 32
SECRET_KEY=

# REQUERIDO (dev y prod) — Contraseña del usuario administrador inicial (seed).
# Debe cumplir la política: 10+ chars, mayúscula, minúscula, dígito y caracter especial.
SEED_ADMIN_PASSWORD=

# Opcionales en dev — se usan estos valores por defecto si no se definen.
SEED_ADMIN_EMAIL=admin@crowrepuestos.com
SEED_USER_EMAIL=cliente@crowrepuestos.com
SEED_USER_PASSWORD=cliente1234

# ── Solo PRODUCCIÓN (docker-compose.prod.yml) ────────────────

# REQUERIDO en prod — Dominio del sitio (Caddy emite el certificado TLS para este dominio).
# El DNS tiene que apuntar al servidor antes del primer arranque.
DOMAIN=

# REQUERIDO en prod — Password de PostgreSQL (en dev defaultea a crow_dev_password).
# Generá una con: openssl rand -hex 24
POSTGRES_PASSWORD=

# REQUERIDO en prod — Password de Redis.
# Generá una con: openssl rand -hex 24
REDIS_PASSWORD=

# Opcionales en prod — SMTP para mails de cotizaciones y reset de contraseña.
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=ventas@crowrepuestos.com.ar

# Opcionales — upload de imágenes (deshabilitado si están vacíos).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional — error tracking en producción (backend + frontend). Vacío
# deshabilita Sentry por completo, sin tocar código. Creá un proyecto en
# sentry.io (uno "Python/FastAPI" y uno "React") para obtener cada DSN.
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── Avanzado ─────────────────────────────────────────────────

# IPs o rangos CIDR de proxies reversos de confianza. Los compose ya pasan
# la subnet fija del stack (172.28.0.0/16) por defecto — solo definila si tu
# topología de red es distinta. Con la lista vacía, X-Forwarded-For se ignora.
# TRUSTED_PROXIES=172.28.0.0/16

# Cantidad de procesos uvicorn del API (default: 2 en dev, 4 en prod -- ver
# backend/Dockerfile y docker-compose.prod.yml). Regla general: ~2×cores
# disponibles en el servidor, sin necesidad de tocar pgbouncer (ya soporta
# hasta 200 conexiones de cliente).
# UVICORN_WORKERS=4

# ── Solo PRODUCCIÓN — versionado de imágenes ──────────────────

# Tag de las imágenes Docker a desplegar (docker-compose.prod.yml usa
# `image:`, no `build:` -- ver DEPLOY.md, sección "Versionado y rollback").
# `latest` sigue siempre al último tag `vX.Y.Z` publicado por
# .github/workflows/release.yml. Para desplegar/volver a una versión
# específica, usar el número de versión sin la `v` (ej. el tag git `v1.4.0`
# es la imagen `1.4.0`).
IMAGE_TAG=latest
