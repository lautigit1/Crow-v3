# Terminador TLS del stack de producción (ver docker-compose.prod.yml).
#
# Caddy emite y renueva solo los certificados de Let's Encrypt para $DOMAIN.
# Requisitos: el DNS del dominio apuntando al servidor, y los puertos 80/443
# abiertos. Todo el tráfico se proxya al nginx del frontend (web:8080 --
# nginx-unprivileged, sin root dentro del contenedor), que a su vez proxya
# /api al backend.
#
# Caddy agrega X-Forwarded-For con la IP real del cliente; nginx la encadena
# con $proxy_add_x_forwarded_for, y el backend (client_ip() en audit.py)
# recorre la cadena DE DERECHA A IZQUIERDA y se queda con la última entrada
# que no caiga en TRUSTED_PROXIES (la subnet fija 172.28.0.0/16 del compose).
#
# De derecha a izquierda y no al revés: la primera entrada de la cadena no la
# escribió ningún proxy, la escribió quien hizo la petición, así que vale lo
# que valga su palabra. Tomarla permitía falsear la IP en el log de auditoría
# y esquivar los limitadores que se llavean solo por IP.

{$DOMAIN} {
	# El canal de eventos (SSE) se sirve SIN compresión.
	#
	# `encode gzip` acumula la respuesta para comprimirla, y una respuesta que no
	# termina nunca -- que es exactamente lo que es un stream SSE -- queda
	# atrapada en ese buffer: los eventos no llegan, o llegan en lotes minutos
	# después.
	#
	# Esto NO se reproduce en desarrollo: ahí el navegador entra directo al nginx
	# del contenedor `web`, donde ya hay un `gzip off` para este location. Caddy
	# solo existe en producción, así que sin este bloque la feature andaría en
	# local y fallaría en el servidor, que es el peor lugar para descubrirlo.
	#
	# `handle` en vez de `route`: los bloques son mutuamente excluyentes, así que
	# el primero que matchea es el único que corre.
	@sse path /api/events
	handle @sse {
		reverse_proxy web:8080
	}

	handle {
		encode gzip
		reverse_proxy web:8080
	}
}
