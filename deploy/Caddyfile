# Terminador TLS del stack de producción (ver docker-compose.prod.yml).
#
# Caddy emite y renueva solo los certificados de Let's Encrypt para $DOMAIN.
# Requisitos: el DNS del dominio apuntando al servidor, y los puertos 80/443
# abiertos. Todo el tráfico se proxya al nginx del frontend (web:80), que a
# su vez proxya /api al backend.
#
# Caddy agrega X-Forwarded-For con la IP real del cliente; nginx la encadena
# con $proxy_add_x_forwarded_for, y el backend (client_ip() en audit.py) toma
# la primera de la cadena porque el peer directo cae en TRUSTED_PROXIES
# (la subnet fija 172.28.0.0/16 del compose).

{$DOMAIN} {
	encode gzip
	reverse_proxy web:80
}
