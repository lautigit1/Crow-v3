{% extends "_base.html.jinja" %}

{% block titulo_documento %}Tu pedido #{{ order_id }}{% endblock %}

{% block preheader %}{{ resumen }}{% endblock %}

{% block titulo %}{{ titulo }}{% endblock %}

{% block entrada %}Hola {{ name }}, hay novedades de tu pedido.{% endblock %}

{% block cuerpo %}
<tr>
  <td style="padding:24px 44px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F7FC; border-radius:10px;">

      <tr>
        <td style="padding:16px 18px 6px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:1px; text-transform:uppercase; color:#8496A9;">
          Pedido
        </td>
        <td align="right" style="padding:16px 18px 6px; font-family:Consolas,Monaco,'Courier New',monospace; font-size:14px; font-weight:700; color:#0B1524;">
          N.&ordm; {{ '%05d' % order_id }}
        </td>
      </tr>

      {# Cada eje solo aparece si cambió. Mostrar el otro "sin cambios" agrega
         ruido a un correo que tiene una sola cosa que decir. #}
      {% if estado_entrega %}
      <tr>
        <td style="padding:6px 18px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13.5px; color:#5A6B7F;">
          Entrega
        </td>
        <td align="right" style="padding:6px 18px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13.5px; font-weight:700; color:#0B1524;">
          {{ estado_entrega }}
        </td>
      </tr>
      {% endif %}

      {% if estado_cobro %}
      <tr>
        <td style="padding:6px 18px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13.5px; color:#5A6B7F;">
          Pago
        </td>
        <td align="right" style="padding:6px 18px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13.5px; font-weight:700; color:#0B1524;">
          {{ estado_cobro }}
        </td>
      </tr>
      {% endif %}

      <tr><td colspan="2" style="padding:0 0 10px;">&nbsp;</td></tr>
    </table>
  </td>
</tr>

{% if detalle %}
<tr>
  <td style="padding:20px 44px 0; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14.5px; line-height:1.6; color:#3D4C5F;">
    {{ detalle }}
  </td>
</tr>
{% endif %}
{% endblock %}

{% block cta %}
<tr>
  <td style="padding:26px 44px 0;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        {# El padding va en la celda y no en el <a>: Outlook lo ignora en el
           enlace y el botón queda del tamaño exacto del texto. #}
        <td align="center" bgcolor="#0057D9" style="border-radius:10px;">
          <a href="{{ orders_url }}"
             style="display:inline-block; padding:14px 30px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:15px; font-weight:700; color:#FFFFFF; text-decoration:none; border-radius:10px;">
            Ver mi pedido
          </a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td style="padding:14px 44px 0;">
    <p style="margin:0; font-family:Consolas,Monaco,'Courier New',monospace; font-size:11.5px; line-height:1.5; color:#8496A9; word-break:break-all;">
      {{ orders_url }}
    </p>
  </td>
</tr>
{% endblock %}

{% block cierre %}
<tr>
  <td style="padding:28px 44px 0;">
    <div style="height:1px; line-height:1px; font-size:0; background-color:#E8EDF4;">&nbsp;</div>
  </td>
</tr>
<tr>
  <td style="padding:18px 44px 40px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13px; line-height:1.6; color:#8496A9;">
    Cualquier duda respondé este correo o escribinos por WhatsApp y lo vemos.
  </td>
</tr>
{% endblock %}

{% block motivo %}Recibís este correo porque hiciste un pedido en Crow Repuestos.{% endblock %}
